# Starts youtube-helper-update.service once a day; see that file for how to install both.

[Unit]
Description=Update youtube-helper to the latest image daily

[Timer]
OnCalendar=daily
# Spread the pull over the first hours of the day instead of exactly at midnight.
RandomizedDelaySec=4h
# Catch up on a run missed while the host was off.
Persistent=true

[Install]
WantedBy=timers.target
