# Pulls the latest youtube-helper image, recreates the container if the image changed and
# removes the image it replaced.
# Started daily by youtube-helper-update.timer; see "Updates" in the README.
#
# Install both files into /etc/systemd/system/, then:
#   systemctl daemon-reload
#   systemctl enable --now youtube-helper-update.timer
# Run it once by hand and check the result:
#   systemctl start youtube-helper-update.service
#   journalctl -u youtube-helper-update.service

[Unit]
Description=Update youtube-helper to the latest image
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# adjust: the directory holding youtube-helper's compose.yaml.
WorkingDirectory=/srv/youtube-helper
# Each command runs only if the one before succeeded. The prune removes dangling (untagged)
# images, which includes the one `pull` replaced.
ExecStart=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d
ExecStart=/usr/bin/docker image prune --force
