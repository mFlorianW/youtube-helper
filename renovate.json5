{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Renovate merges by itself, once every check on the PR has passed, instead of relying on
  // GitHub's auto-merge; that would merge right away unless branch protection requires the
  // checks. The Renovate GitHub app merges with its own token (unlike GITHUB_TOKEN), so the
  // push to main runs CI and publishes the image.
  platformAutomerge: false,
  packageRules: [
    {
      // YouTube-side fixes arrive as yt-dlp and yt-dlp-ejs releases, so these get to the
      // image without anyone looking. yt-dlp pins the exact yt-dlp-ejs version it needs:
      // updating the lockfile for both together keeps them in step, and a yt-dlp-ejs
      // release yt-dlp doesn't want yet changes nothing.
      description: "Auto-merge yt-dlp and yt-dlp-ejs updates",
      matchManagers: ["pep621"],
      matchPackageNames: ["yt-dlp", "yt-dlp-ejs"],
      groupName: "yt-dlp",
      rangeStrategy: "update-lockfile",
      automerge: true,
    },
    {
      // The JavaScript runtime yt-dlp-ejs runs YouTube's challenges in. Its binary-only
      // image tags look like `bin-2.9.7`.
      matchManagers: ["dockerfile"],
      matchPackageNames: ["denoland/deno"],
      versioning: "regex:^bin-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      // A new Deno major may break yt-dlp-ejs in ways CI can't see, so it waits for a human.
      description: "Auto-merge Deno minor and patch updates",
      matchManagers: ["dockerfile"],
      matchPackageNames: ["denoland/deno"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
  ],
}
